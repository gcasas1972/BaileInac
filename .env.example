# Connection string de Neon, disponible en la integración de Vercel Marketplace.
DATABASE_URL=

# Genera un valor aleatorio de al menos 32 caracteres; no lo compartas ni lo subas al repositorio.
AUTH_SECRET=

# Credenciales del primer administrador.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Credenciales opcionales de administradores adicionales. Continúa con _3, _4, etc.
ADMIN_EMAIL_2=
ADMIN_PASSWORD_2=
